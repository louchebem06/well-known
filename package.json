{
	"name": "well-known",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"build": "pnpm -r build",
		"test": "pnpm -r test && vitest run scripts/*.test.ts",
		"check:integrations": "node --import tsx scripts/check-integrations.ts",
		"release:prepare": "node --import tsx scripts/prepare-release.ts && pnpm install --lockfile-only",
		"release:publish": "node --import tsx scripts/publish-release.ts",
		"release:github": "node --import tsx scripts/create-github-releases.ts",
		"standards:check": "node --import tsx scripts/check-standards.ts",
		"standards:refresh": "node --import tsx scripts/check-standards.ts --refresh",
		"test:watch": "pnpm -r --parallel test:watch",
		"test:coverage": "pnpm -r test:coverage",
		"typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
		"dev": "pnpm --filter './examples/*' --parallel --stream dev",
		"dev:packages": "pnpm --filter './packages/*' --parallel dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.0.0",
		"@types/semver": "^7.7.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.6",
		"semver": "^7.7.0",
		"tsup": "^8.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.70.0",
		"vitest": "^3.2.7"
	}
}
