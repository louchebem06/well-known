{
	"name": "nestjs-example",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "nest start --watch",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/main.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@well-known-js/apple-app-site-association": "workspace:*",
		"@well-known-js/assetlinks": "workspace:*",
		"@well-known-js/core": "workspace:*",
		"@well-known-js/nestjs": "workspace:*",
		"@well-known-js/security-txt": "workspace:*",
		"@well-known-js/webauthn": "workspace:*",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.2.7"
	}
}
