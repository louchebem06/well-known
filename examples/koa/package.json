{
	"name": "koa-example",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@well-known-js/apple-app-site-association": "workspace:*",
		"@well-known-js/assetlinks": "workspace:*",
		"@well-known-js/core": "workspace:*",
		"@well-known-js/koa": "workspace:*",
		"@well-known-js/passkey-endpoints": "workspace:*",
		"@well-known-js/security-txt": "workspace:*",
		"@well-known-js/webauthn": "workspace:*",
		"koa": "^3.2.1"
	},
	"devDependencies": {
		"@types/koa": "^3.0.3",
		"@types/node": "^24.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.2.7"
	}
}
