{
	"name": "sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5101 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@well-known-js/agent-card": "workspace:*",
		"@well-known-js/api-catalog": "workspace:*",
		"@well-known-js/apple-app-site-association": "workspace:*",
		"@well-known-js/assetlinks": "workspace:*",
		"@well-known-js/core": "workspace:*",
		"@well-known-js/openid-configuration": "workspace:*",
		"@well-known-js/oauth-authorization-server": "workspace:*",
		"@well-known-js/oauth-protected-resource": "workspace:*",
		"@well-known-js/passkey-endpoints": "workspace:*",
		"@well-known-js/security-txt": "workspace:*",
		"@well-known-js/sveltekit": "workspace:*",
		"@well-known-js/webauthn": "workspace:*"
	}
}
