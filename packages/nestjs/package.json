{
	"name": "@well-known-js/nestjs",
	"version": "1.0.0",
	"description": "NestJS integration for serving .well-known routes.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/louchebem06/well-known.git",
		"directory": "packages/nestjs"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --clean",
		"dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --watch",
		"typecheck": "tsc -b",
		"test": "vitest run"
	},
	"dependencies": {
		"@well-known-js/core": "workspace:*"
	},
	"peerDependencies": {
		"@nestjs/common": ">=11 <13",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.1.0"
	},
	"devDependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/testing": "^12.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.0"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
