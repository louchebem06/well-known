{
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"experimentalDecorators": true
	},
	"references": [
		{
			"path": "../core"
		}
	],
	"include": ["src/**/*.ts"]
}
