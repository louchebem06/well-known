{
	"name": "@well-known-js/nuxt",
	"version": "1.0.2",
	"description": "Nuxt module for generating .well-known files.",
	"homepage": "https://www.bryanledda.fr/fr/products/tools/well-known-js",
	"keywords": [
		"well-known",
		"typescript",
		"nuxt",
		"vue",
		"web-standards",
		"module"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/louchebem06/well-known.git",
		"directory": "packages/nuxt"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --clean",
		"dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --watch",
		"typecheck": "tsc -b",
		"test": "vitest run"
	},
	"dependencies": {
		"@nuxt/kit": "^3.21.11",
		"@nuxt/schema": "^3.21.11",
		"@well-known-js/core": "workspace:*",
		"jiti": "^2.7.0"
	},
	"peerDependencies": {
		"nuxt": ">=3 <5"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
