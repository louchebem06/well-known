{
	"name": "@well-known-js/adonisjs",
	"version": "1.0.2",
	"description": "AdonisJS middleware for serving .well-known routes.",
	"homepage": "https://www.bryanledda.fr/fr/products/tools/well-known-js",
	"keywords": [
		"well-known",
		"typescript",
		"adonisjs",
		"web-standards",
		"middleware"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/louchebem06/well-known.git",
		"directory": "packages/adonisjs"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --clean",
		"dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --watch",
		"typecheck": "tsc -b",
		"test": "vitest run"
	},
	"dependencies": {
		"@well-known-js/core": "workspace:*",
		"@well-known-js/node": "workspace:*"
	},
	"peerDependencies": {
		"@adonisjs/core": ">=6 <7"
	},
	"peerDependenciesMeta": {
		"@adonisjs/core": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
