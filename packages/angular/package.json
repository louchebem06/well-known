{
	"name": "@well-known/angular",
	"version": "1.0.0",
	"description": "Angular SSR middleware for serving .well-known routes.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --clean",
		"dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --watch",
		"typecheck": "tsc -b",
		"test": "vitest run"
	},
	"dependencies": {
		"@well-known/core": "workspace:*",
		"@well-known/node": "workspace:*"
	},
	"peerDependencies": {
		"@angular/ssr": ">=19 <22"
	},
	"peerDependenciesMeta": {
		"@angular/ssr": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
