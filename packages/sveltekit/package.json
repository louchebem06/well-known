{
	"name": "@well-known-js/sveltekit",
	"version": "1.0.2",
	"description": "SvelteKit integration for generating .well-known files.",
	"homepage": "https://www.bryanledda.fr/fr/products/tools/well-known-js",
	"keywords": [
		"well-known",
		"typescript",
		"sveltekit",
		"svelte",
		"web-standards",
		"integration"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/louchebem06/well-known.git",
		"directory": "packages/sveltekit"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --clean",
		"dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --watch",
		"typecheck": "tsc -b",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@well-known-js/vite": "workspace:*"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=2",
		"vite": ">=5"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
