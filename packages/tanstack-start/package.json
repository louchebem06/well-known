{
	"name": "@well-known-js/tanstack-start",
	"version": "1.0.1",
	"description": "TanStack Start server handlers for .well-known routes.",
	"keywords": [
		"well-known",
		"typescript",
		"tanstack-start",
		"tanstack",
		"web-standards",
		"server-handler"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/louchebem06/well-known.git",
		"directory": "packages/tanstack-start"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --clean",
		"dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --watch",
		"typecheck": "tsc -b",
		"test": "vitest run"
	},
	"dependencies": {
		"@well-known-js/core": "workspace:*",
		"@well-known-js/node": "workspace:*"
	},
	"peerDependencies": {
		"@tanstack/react-start": ">=1 <2"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-start": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
