{
	"name": "@well-known-js/elysia",
	"version": "1.0.1",
	"description": "Elysia plugin for serving .well-known routes.",
	"keywords": [
		"well-known",
		"typescript",
		"elysia",
		"bun",
		"web-standards",
		"plugin"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/louchebem06/well-known.git",
		"directory": "packages/elysia"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --clean",
		"dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --dts --watch",
		"typecheck": "tsc -b",
		"test": "vitest run"
	},
	"dependencies": {
		"@well-known-js/core": "workspace:*"
	},
	"peerDependencies": {
		"elysia": ">=1 <2"
	},
	"devDependencies": {
		"elysia": "^1.4.30",
		"typescript": "^5.0.0"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
